# 复制成 .env 后填自己的值即可（.env 已被 .gitignore 忽略，不会进仓库）
# 真实环境变量优先于本文件：命令行里 export 过的键不会被这里覆盖。

# ── 会话类型 ──────────────────────────────────────────────────────────
# mock（默认，离线剧本）| rpc（唯一 agent 后端，见 docs/architecture.md）
VT_AGENT=mock

# ── 唯一 agent 后端（VT_AGENT=rpc 时用）───────────────────────────────
# 起服务：pnpm backend（= cd backend && uv run python rpc_server.py）
# 模型与密钥在后端配置（AGENT_RPC_MODEL / AGENT_RPC_API_KEY），前端不接触。
VT_RPC_URL=ws://127.0.0.1:8765
VT_RPC_MODEL=cn:hy3

# ── agent 工具工作区 ──────────────────────────────────────────────────
# 后端文件/命令工具的根（后端 AGENT_RPC_WORKSPACE 默认同目录）；/env 展示用。
# 注意：这不是沙箱，命令是真跑的，别指向重要目录。
VT_AGENT_ROOT=./.agent-sandbox

# ── 持久会话（可选）──────────────────────────────────────────────────
# 会话目录（默认 <repo>/.verse-sessions/，已 gitignore）
# VT_SESSION_DIR=./.verse-sessions
# 启动时恢复会话：VT_CONTINUE=1 接着最近一次；或 VT_SESSION=<会话 id> 指定
# VT_CONTINUE=1
# VT_SESSION=
# 彻底关闭落盘（逃生门）
# VT_NO_PERSIST=1

# ── 可选：节奏与出图 ──────────────────────────────────────────────────
# 流式每块的延迟倍数（1=默认观感，0=尽快跑完，smoke 用 0.1）
VT_SPEED=1
# shot 的视口高度（行）：越大越能装下完整一轮
VT_SHOT_ROWS=42
# rpc 端到端检查的预算（毫秒）
VT_CHECK_TIMEOUT_MS=150000
