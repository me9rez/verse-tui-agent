{
  "name": "vue-tui-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Claude Code 风格的终端界面 demo（@simon_he/vue-tui），支持流式输出",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "node src/terminal.ts",
    "smoke": "node src/smoke.ts && node src/env-check.ts",
    "shot": "node src/shot.ts",
    "live": "node src/live-check.ts",
    "agent": "node src/agent-check.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.51",
    "@simon_he/vue-tui": "^1.1.9",
    "ai": "^7.0.105",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
