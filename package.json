{
  "name": "verse-tui-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Verse · 用 @simon_he/vue-tui 搭的终端流式 agent demo（思考/工具块可折叠）",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "node src/cli/terminal.ts",
    "smoke": "node src/checks/smoke.ts && node src/checks/env-check.ts",
    "shot": "node src/cli/shot.ts",
    "live": "node src/checks/live-check.ts",
    "agent": "node src/checks/agent-check.ts",
    "typecheck": "tsc -p tsconfig.json",
    "sessions": "node src/checks/session-check.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.51",
    "@simon_he/vue-tui": "^1.1.9",
    "ai": "^7.0.105",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
